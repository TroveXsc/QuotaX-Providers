  "paths": {
    "/user/balance": {
      "get": {
        "operationId": "getBalance",
        "summary": "查询余额",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          }
        },
        "x-quotax": {
          "runtimeRef": "getBalance"
        }
      }
    }
  },
