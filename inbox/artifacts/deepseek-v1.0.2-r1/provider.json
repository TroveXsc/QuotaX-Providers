      "apiKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Balance": {
        "type": "object",
        "required": [
          "is_available",
          "balance_infos"
        ],
        "properties": {
          "is_available": {
            "type": "boolean"
          },
          "balance_infos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "currency",
                "total_balance",
                "granted_balance",
                "topped_up_balance"
              ],
              "properties": {
                "currency": {
                  "type": "string"
                },
                "total_balance": {
                  "type": "string"
                },
                "granted_balance": {
                  "type": "string"
                },
                "topped_up_balance": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
